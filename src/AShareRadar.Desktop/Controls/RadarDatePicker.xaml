<UserControl x:Class="AShareRadar.Desktop.Controls.RadarDatePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="30"
             d:DesignWidth="138">
    <UserControl.Resources>
        <Style x:Key="ChromeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root">
        <Border x:Name="InputChrome"
                Height="{Binding ActualHeight, ElementName=Root}"
                MinHeight="30"
                Background="{DynamicResource InputBrush}"
                BorderBrush="{DynamicResource BorderBrushSoft}"
                BorderThickness="1"
                CornerRadius="6"
                Cursor="Hand"
                MouseLeftButtonUp="InputChrome_MouseLeftButtonUp">
            <Grid Margin="10,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="DisplayTextBlock"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextBrush}"
                           FontSize="13"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1"
                           Margin="8,0,0,1"
                           Text="▾"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="12"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Popup x:Name="CalendarPopup"
               PlacementTarget="{Binding ElementName=InputChrome}"
               Placement="Bottom"
               AllowsTransparency="True"
               StaysOpen="False"
               PopupAnimation="Fade">
            <Border Width="328"
                    Height="423"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrushSoft}"
                    BorderThickness="1"
                    SnapsToDevicePixels="True">
                <Grid Margin="15,18,14,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="34" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="HeaderButton"
                                Style="{StaticResource ChromeButtonStyle}"
                                HorizontalAlignment="Left"
                                Click="HeaderButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="HeaderTextBlock"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Margin="6,1,0,0"
                                           Text="▾"
                                           FontSize="11"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1"
                                Style="{StaticResource ChromeButtonStyle}"
                                Content="↑"
                                FontSize="32"
                                FontWeight="Light"
                                Foreground="{DynamicResource TextBrush}"
                                Click="PreviousButton_Click" />
                        <Button Grid.Column="2"
                                Style="{StaticResource ChromeButtonStyle}"
                                Content="↓"
                                FontSize="32"
                                FontWeight="Light"
                                Foreground="{DynamicResource TextBrush}"
                                Click="NextButton_Click" />
                    </Grid>

                    <Grid x:Name="DayView" Grid.Row="1" Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <UniformGrid Grid.Row="0" Columns="7">
                            <TextBlock Text="一" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Text="二" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Text="三" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Text="四" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Text="五" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Text="六" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Text="日" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </UniformGrid>
                        <UniformGrid x:Name="DayGrid" Grid.Row="1" Columns="7" Rows="6" Margin="0,8,0,0" />
                    </Grid>

                    <Grid x:Name="MonthView" Grid.Row="1" Margin="0,14,0,0" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36" />
                            <RowDefinition Height="36" />
                            <RowDefinition Height="36" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="36" />
                            <RowDefinition Height="36" />
                        </Grid.RowDefinitions>
                        <Button x:Name="YearMinus2Button" Grid.Row="0" Style="{StaticResource ChromeButtonStyle}" HorizontalContentAlignment="Left" Click="YearButton_Click" />
                        <Border Grid.Row="1" Background="{DynamicResource SoftPanelBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,1,0,1">
                            <Button x:Name="YearMinus1Button" Style="{StaticResource ChromeButtonStyle}" HorizontalContentAlignment="Left" Click="YearButton_Click" />
                        </Border>
                        <Border Grid.Row="2" Background="{DynamicResource SoftPanelBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,0,1">
                            <Button x:Name="CurrentYearButton" Style="{StaticResource ChromeButtonStyle}" HorizontalContentAlignment="Left" Click="YearButton_Click" />
                        </Border>
                        <UniformGrid x:Name="MonthGrid" Grid.Row="3" Columns="4" Rows="3" Margin="0,6,0,8" />
                        <Border Grid.Row="4" Background="{DynamicResource SoftPanelBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,0,1">
                            <Button x:Name="YearPlus1Button" Style="{StaticResource ChromeButtonStyle}" HorizontalContentAlignment="Left" Click="YearButton_Click" />
                        </Border>
                        <Border Grid.Row="5" Background="{DynamicResource SoftPanelBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,0,1">
                            <Button x:Name="YearPlus2Button" Style="{StaticResource ChromeButtonStyle}" HorizontalContentAlignment="Left" Click="YearButton_Click" />
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ClearButton"
                                Style="{StaticResource ChromeButtonStyle}"
                                HorizontalAlignment="Left"
                                Content="清除"
                                Foreground="{DynamicResource PrimaryBrush}"
                                FontSize="18"
                                Click="ClearButton_Click" />
                        <Button x:Name="TodayButton"
                                Grid.Column="1"
                                Style="{StaticResource ChromeButtonStyle}"
                                HorizontalAlignment="Right"
                                Content="今天"
                                Foreground="{DynamicResource PrimaryBrush}"
                                FontSize="18"
                                Click="TodayButton_Click" />
                    </Grid>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>

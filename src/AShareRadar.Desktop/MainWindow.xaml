                                        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="18">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="3*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="A股情绪温度" FontSize="18" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="MarketSentimentPageSummaryText" Margin="0,8,0,0" Foreground="{DynamicResource MutedTextBrush}" Text="等待实时情绪快照。" TextWrapping="Wrap" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0" VerticalAlignment="Bottom">
                                                        <TextBlock x:Name="MarketSentimentPageScoreText" Text="--" FontSize="46" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" />
                                                        <TextBlock Text="/100" Margin="4,24,0,0" FontSize="18" Foreground="{DynamicResource MutedTextBrush}" />
                                                        <Border x:Name="MarketSentimentPageLevelBadge" Margin="14,22,0,0" Background="{DynamicResource PrimarySoftBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="10,4">
                                                            <TextBlock x:Name="MarketSentimentPageLevelText" Text="等待" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" />
                                                        </Border>
                                                    </StackPanel>
                                                    <Grid Margin="0,14,0,0" Height="42">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="12" />
                                                            <RowDefinition Height="*" />
                                                        </Grid.RowDefinitions>
                                                        <Grid Grid.Row="0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="30*" />
                                                                <ColumnDefinition Width="15*" />
                                                                <ColumnDefinition Width="15*" />
                                                                <ColumnDefinition Width="15*" />
                                                                <ColumnDefinition Width="25*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Background="#5AC8FA" CornerRadius="6,0,0,6" />
                                                            <Border Grid.Column="1" Background="#AFDFFF" />
                                                            <Border Grid.Column="2" Background="#34C759" />
                                                            <Border Grid.Column="3" Background="#FFCC00" />
                                                            <Border Grid.Column="4" Background="#FF3B30" CornerRadius="0,6,6,0" />
                                                        </Grid>
                                                        <Canvas Grid.Row="0">
                                                            <Border x:Name="MarketSentimentPageNeedle" Canvas.Left="0" Canvas.Top="-4" Width="8" Height="20" Background="#111827" CornerRadius="4" />
                                                        </Canvas>
                                                        <Grid Grid.Row="1" Margin="0,8,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition />
                                                                <ColumnDefinition />
                                                                <ColumnDefinition />
                                                                <ColumnDefinition />
                                                                <ColumnDefinition />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="冰点" FontSize="11" Foreground="{DynamicResource SubtleTextBrush}" />
                                                            <TextBlock Grid.Column="1" Text="偏冷" FontSize="11" Foreground="{DynamicResource SubtleTextBrush}" />
                                                            <TextBlock Grid.Column="2" Text="中性" FontSize="11" Foreground="{DynamicResource SubtleTextBrush}" />
                                                            <TextBlock Grid.Column="3" Text="偏热" FontSize="11" Foreground="{DynamicResource SubtleTextBrush}" />
                                                            <TextBlock Grid.Column="4" Text="过热" FontSize="11" Foreground="{DynamicResource SubtleTextBrush}" HorizontalAlignment="Right" />
                                                        </Grid>
                                                    </Grid>
                                                </StackPanel>
                                                <Border Grid.Column="2" Background="{DynamicResource CardDarkBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="18">
                                                    <StackPanel>
                                                        <TextBlock Text="策略环境提示" FontSize="16" FontWeight="SemiBold" />
                                                        <TextBlock x:Name="MarketSentimentPageStrategyText" Margin="0,8,0,0" Text="等待情绪数据刷新。" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                                                        <UniformGrid Columns="2" Margin="0,14,0,0">
                                                            <TextBlock Text="主线板块共振：正常启用" Margin="0,0,10,8" Foreground="{DynamicResource PrimaryBrush}" />
                                                            <TextBlock Text="平台放量突破：正常启用" Margin="0,0,0,8" Foreground="{DynamicResource PrimaryBrush}" />

                                            </WrapPanel>
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Row="1" Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="320" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Column="0" Grid.Row="0" Text="策略表现" FontWeight="SemiBold" />
                                        <ListBox x:Name="HistoryStrategyListBox" Grid.Column="0" Grid.Row="1" Margin="0,8,0,0" ItemContainerStyle="{StaticResource FlatListBoxItemStyle}" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#FFFFFF" BorderBrush="#E3EAF1" BorderThickness="1" CornerRadius="5" Padding="10" HorizontalAlignment="Stretch">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="72" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding StrategyName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LastHitTime}" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" HorizontalAlignment="Right" />
                                                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0" Text="{Binding SummaryText}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <TextBlock Grid.Column="2" Grid.Row="0" Text="历史信号" FontWeight="SemiBold" />
                                        <ListBox x:Name="HistorySignalListBox" Grid.Column="2" Grid.Row="1" Margin="0,8,0,0" ItemContainerStyle="{StaticResource FlatListBoxItemStyle}" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#FFFFFF" BorderBrush="#E3EAF1" BorderThickness="1" CornerRadius="5" Padding="10" HorizontalAlignment="Stretch">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="90" />
                                                                <ColumnDefinition Width="96" />
                                                                <ColumnDefinition Width="170" />
                                                                <ColumnDefinition Width="*" MinWidth="260" />
                                                                <ColumnDefinition Width="96" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="{Binding EventTime}" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding EventType}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="2" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ClipToBounds="True">
                                                                <Run Text="{Binding Symbol}" />
                                                                <Run Text=" " />
                                                                <Run Text="{Binding Name}" />
                                                            </TextBlock>
                                                            <StackPanel Grid.Column="3" ClipToBounds="True">
                                                                <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis">
                                                                    <Run Text="{Binding StrategyName}" />
                                                                    <Run Text="   " />
                                                                    <Run Text="{Binding HitText}" />
                                                                </TextBlock>
                                                                <TextBlock Margin="0,4,0,0" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" Text="{Binding Reason}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="4" Text="{Binding ScoreText}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Grid>

                                <ScrollViewer x:Name="StrategyCenterPanel" Grid.Row="1" Margin="0,10,0,0" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <StackPanel HorizontalAlignment="Stretch" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                                        <Border Background="#FFFFFF" BorderBrush="#E3EAF1" BorderThickness="1" CornerRadius="5" Padding="12">
                                            <StackPanel>
                                                <TextBlock Text="策略中心" FontSize="18" FontWeight="SemiBold" />
                                                <TextBlock x:Name="StrategyCenterSummaryText" Margin="0,8,0,0" Foreground="{StaticResource MutedTextBrush}" Text="暂无策略数据" TextWrapping="Wrap" />
                                                <TextBlock x:Name="StrategySentimentRulesText" Margin="0,8,0,0" Foreground="{StaticResource PrimaryBrush}" Text="情绪规则：等待加载" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                        <Border Margin="0,10,0,0" Background="#F8FBFD" BorderBrush="#CFE0F2" BorderThickness="1" CornerRadius="5" Padding="10">
                                            <StackPanel>
                                                <TextBlock Text="情绪因子" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                                                <TextBlock Margin="0,6,0,0"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           FontSize="12"
                                                           Text="实时扫描和策略回放会把 A股情绪温度写入信号：冰点/偏冷降低进攻型信号，偏热增强主线与强趋势，过热降低高位进攻并提示拥挤风险。"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <ListBox x:Name="StrategyDefinitionListBox" Margin="0,10,0,0" ItemContainerStyle="{StaticResource FlatListBoxItemStyle}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#FFFFFF" BorderBrush="#E3EAF1" BorderThickness="1" CornerRadius="5" Padding="10">
                                                        <StackPanel>
                                                            <DockPanel>
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding DefaultActionText}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" />
                                                                <TextBlock FontWeight="SemiBold">
                                                                    <Run Text="{Binding Name}" />
                                                                    <Run Text="  " />
                                                                    <Run Text="{Binding Code}" />
                                                                </TextBlock>
                                                            </DockPanel>
                                                            <TextBlock Margin="0,6,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Text="{Binding StageText}" TextWrapping="Wrap" />
                                                            <TextBlock Margin="0,6,0,0" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" Text="{Binding DataRequirementText}" TextWrapping="Wrap" />
                                                            <TextBlock Margin="0,6,0,0" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" Text="{Binding ParameterText}" TextWrapping="Wrap" />
                                                            <TextBlock Margin="0,6,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Text="{Binding Description}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </ScrollViewer>

                                <ScrollViewer x:Name="BacktestPanel" Grid.Row="1" Margin="0,10,0,0" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <StackPanel HorizontalAlignment="Stretch" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                                        <Border Background="#FFFFFF" BorderBrush="#E3EAF1" BorderThickness="1" CornerRadius="5" Padding="12">
                                            <StackPanel>
                                                <TextBlock Text="策略回放" FontSize="18" FontWeight="SemiBold" />
                                                <TextBlock x:Name="BacktestSummaryText" Margin="0,8,0,0" Foreground="{StaticResource MutedTextBrush}" Text="输入股票和区间后执行回放。" TextWrapping="Wrap" />
                                                <TextBlock Margin="0,10,0,0" Text="回放范围" Style="{StaticResource CaptionStyle}" />
                                                <ComboBox x:Name="BacktestStockPoolComboBox" Margin="0,6,0,0" Height="30" SelectedIndex="0">
                                                    <ComboBoxItem Content="手动输入" />
                                                    <ComboBoxItem Content="历史库前N只" />
                                                    <ComboBoxItem Content="最近活跃池" />
                                                </ComboBox>
                                                <TextBlock Margin="0,6,0,0" Text="数量上限" Style="{StaticResource CaptionStyle}" />
                                                <TextBox x:Name="BacktestMaxSymbolsTextBox" Margin="0,6,0,0" Height="30" Text="30" ToolTip="历史库模式下使用，建议先用 20-50 验证。" />
                                                <WrapPanel Margin="0,6,0,0">
                                                    <Button x:Name="BacktestScale20Button" Width="48" Height="26" Padding="6,0" Content="20" Click="BacktestScale20Button_Click" />
                                                    <Button x:Name="BacktestScale50Button" Width="48" Height="26" Padding="6,0" Content="50" Click="BacktestScale50Button_Click" />
                                                    <Button x:Name="BacktestScale100Button" Width="48" Height="26" Padding="6,0" Content="100" Click="BacktestScale100Button_Click" />
                                                </WrapPanel>
                                                <TextBlock Margin="0,10,0,0" Text="开始日期" Style="{StaticResource CaptionStyle}" />
                                                <hc:DatePicker x:Name="BacktestStartDatePicker" Margin="0,6,0,0" Height="32" />
                                                <TextBlock Margin="0,6,0,0" Text="结束日期" Style="{StaticResource CaptionStyle}" />
                                                <hc:DatePicker x:Name="BacktestEndDatePicker" Margin="0,6,0,0" Height="32" />
                                                <TextBlock Margin="0,6,0,0" Text="股票代码" Style="{StaticResource CaptionStyle}" />
                                                <TextBox x:Name="BacktestSymbolsTextBox" Margin="0,6,0,0" Height="30" Text="600000,300059" ToolTip="多个股票用逗号分隔，例如 300059,600000" />
                                                <TextBlock Margin="0,6,0,0" Text="策略代码" Style="{StaticResource CaptionStyle}" />
                                                <TextBox x:Name="BacktestStrategiesTextBox" Margin="0,6,0,0" Height="30" Text="moving-average-pullback-restart,platform-volume-breakout" ToolTip="留空表示使用全部启用策略" />
                                                <WrapPanel Margin="0,8,0,0">
                                                    <Button x:Name="RunBacktestButton" Width="76" Height="28" Padding="8,0" Content="执行" Style="{StaticResource PrimaryButtonStyle}" Click="RunBacktestButton_Click" />
                                                    <Button x:Name="UseSelectedSymbolBacktestButton" Width="84" Height="28" Padding="8,0" Content="当前股票" Click="UseSelectedSymbolBacktestButton_Click" />
                                                    <Button x:Name="ExportBacktestButton" Width="76" Height="28" Padding="8,0" Content="导出" Click="ExportBacktestButton_Click" />
                                                </WrapPanel>
                                                <CheckBox x:Name="BacktestPositive5DayCheckBox" Margin="0,8,0,0" Content="只看 5 日正收益策略" Click="BacktestPositive5DayCheckBox_Click" />
                                                <TextBlock x:Name="BacktestUsedSymbolsText" Margin="0,8,0,0" Foreground="{StaticResource SubtleTextBrush}" Text="实际股票：--" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Margin="0,14,0,0" Text="策略汇总" FontWeight="SemiBold" />
                                        <ListBox x:Name="BacktestStrategySummaryListBox" Margin="0,8,0,0" MaxHeight="220">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#FFFFFF" BorderBrush="#E3EAF1" BorderThickness="1" CornerRadius="5" Padding="10">
                                                        <StackPanel>
                                                            <DockPanel>
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding SignalCountText}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding StrategyName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            </DockPanel>
                                                            <TextBlock Margin="0,6,0,0" Foreground="{Binding WinRateBrush}" FontSize="12" Text="{Binding WinRateText}" TextWrapping="Wrap" />
                                                            <TextBlock Margin="0,5,0,0" Foreground="{Binding ReturnBrush}" FontSize="12" Text="{Binding ReturnText}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <TextBlock Margin="0,14,0,0" Text="情绪分组表现" FontWeight="SemiBold" />
                                        <ListBox x:Name="BacktestSentimentSummaryListBox" Margin="0,8,0,0" MaxHeight="180">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#FFFFFF" BorderBrush="#E3EAF1" BorderThickness="1" CornerRadius="5" Padding="10">
                                                        <StackPanel>
                                                            <DockPanel>
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding SignalCountText}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding SentimentLevel}" FontWeight="SemiBold" />
                                                            </DockPanel>
                                                            <TextBlock Margin="0,6,0,0" Foreground="{Binding WinRateBrush}" FontSize="12" Text="{Binding WinRateText}" TextWrapping="Wrap" />
                                                            <TextBlock Margin="0,5,0,0" Foreground="{Binding ReturnBrush}" FontSize="12" Text="{Binding ReturnText}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <TextBlock Margin="0,14,0,0" Text="回放命中" FontWeight="SemiBold" />
                                        <ListBox x:Name="BacktestResultListBox" Margin="0,8,0,0">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#FFFFFF" BorderBrush="#E3EAF1" BorderThickness="1" CornerRadius="5" Padding="10">
                                                        <StackPanel>
                                                            <DockPanel>
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding ScoreText}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" />
                                                                <TextBlock FontWeight="SemiBold">
                                                                    <Run Text="{Binding TradingDate}" />
                                                                    <Run Text="  " />
                                                                    <Run Text="{Binding Symbol}" />
                                                                    <Run Text=" " />
                                                                    <Run Text="{Binding Name}" />
                                                                </TextBlock>
                                                            </DockPanel>
                                                            <TextBlock Margin="0,5,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="12">
                                                                <Run Text="{Binding StrategyName}" />
                                                                <Run Text="   " />
                                                                <Run Text="{Binding ActionText}" />
                                                                <Run Text="   置信度 " />
                                                                <Run Text="{Binding ConfidenceText}" />
                                                            </TextBlock>
                                                            <TextBlock Margin="0,5,0,0" Foreground="{StaticResource PrimaryBrush}" FontSize="12" Text="{Binding ReturnText}" />
                                                            <TextBlock Margin="0,5,0,0" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" Text="{Binding Reason}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </ScrollViewer>

                                <Grid x:Name="LongTermTrackingPanel" Grid.Row="1" Margin="0,10,0,0" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E7EDF5" BorderThickness="1" CornerRadius="18" Padding="22">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="↗" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Margin="10,0,0,0" Text="长期跟踪" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                                                    <Border Margin="14,0,0,0" Padding="12,6" Background="#EEF5FF" CornerRadius="18">
                                                        <TextBlock x:Name="LongTermTrackingSummaryText" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" Text="沉淀非主线策略历史命中股票。" />
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                            <WrapPanel Grid.Row="1" Margin="0,22,0,0" VerticalAlignment="Center">
                                                <Grid Width="260" Height="38">
                                                    <TextBox x:Name="LongTermTrackingSymbolTextBox"
                                                             Style="{StaticResource SearchTextBoxStyle}"
                                                             ToolTip="按股票代码或名称查询，例如 300059 或 东方财富" />
                                                    <TextBlock Margin="13,0,0,0"
                                                               VerticalAlignment="Center"
                                                               Foreground="#6F7F93"
                                                               IsHitTestVisible="False"
                                                               Text="股票代码 / 名称">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Text, ElementName=LongTermTrackingSymbolTextBox}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                                <StackPanel Width="134" Margin="12,0,0,0">
                                                    <hc:DatePicker x:Name="LongTermTrackingFromDatePicker"
                                                                   Height="38"
                                                                   hc:InfoElement.Placeholder="开始日期"
                                                                   ToolTip="首次命中日期范围的开始日期" />
                                                </StackPanel>
                                                <StackPanel Width="134" Margin="8,0,0,0">
                                                    <hc:DatePicker x:Name="LongTermTrackingToDatePicker"
                                                                   Height="38"
                                                                   hc:InfoElement.Placeholder="结束日期"
                                                                   ToolTip="首次命中日期范围的结束日期" />
                                                </StackPanel>
                                                <Grid Width="180" Height="38" Margin="8,0,0,0">
                                                    <TextBox x:Name="LongTermTrackingStrategyCodeTextBox"
                                                             Style="{StaticResource SearchTextBoxStyle}"
                                                             ToolTip="按策略编码过滤，例如 strong-trend-continuation" />
                                                    <TextBlock Margin="11,0,0,0"
                                                               VerticalAlignment="Center"
                                                               Foreground="#6F7F93"
                                                               IsHitTestVisible="False"
                                                               Text="策略代码（可选）">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Text, ElementName=LongTermTrackingStrategyCodeTextBox}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                                <ComboBox x:Name="LongTermTrackingStatusComboBox" Width="118" Height="38" Margin="8,0,0,0" SelectedIndex="0">
                                                    <ComboBoxItem Content="全部" Tag="" />
                                                    <ComboBoxItem Content="观察" Tag="Watch" />
                                                    <ComboBoxItem Content="重点" Tag="Focus" />
                                                    <ComboBoxItem Content="放弃" Tag="GiveUp" />
                                                    <ComboBoxItem Content="归档" Tag="Archived" />
                                                </ComboBox>
                                                <ComboBox x:Name="LongTermTrackingSortComboBox" Width="138" Height="38" Margin="8,0,0,0" SelectedIndex="0">
                                                    <ComboBoxItem Content="最近命中" Tag="LastHitAt" />
                                                    <ComboBoxItem Content="首次命中" Tag="FirstHitAt" />
                                                    <ComboBoxItem Content="命中次数" Tag="HitCount" />
                                                    <ComboBoxItem Content="最新分" Tag="LatestScore" />
                                                    <ComboBoxItem Content="最高分" Tag="BestScore" />
                                                </ComboBox>
                                                <Button x:Name="RefreshLongTermTrackingButton" Width="78" Height="38" Margin="10,0,0,0" Padding="0" Content="查询" Style="{StaticResource PrimaryButtonStyle}" Click="RefreshLongTermTrackingButton_Click" />
                                                <Button x:Name="BackfillLongTermTrackingButton" Width="92" Height="38" Margin="8,0,0,0" Padding="0" Content="历史回填" Click="BackfillLongTermTrackingButton_Click" />
                                            </WrapPanel>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Row="1" Margin="0,14,0,0" Background="#FFFFFF" BorderBrush="#E7EDF5" BorderThickness="1" CornerRadius="16" ClipToBounds="True">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="46" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" Background="#F7F9FD" BorderBrush="#EDF2F7" BorderThickness="0,0,0,1">
                                                <Grid Margin="22,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="145" />
                                                        <ColumnDefinition Width="230" />
                                                        <ColumnDefinition Width="210" />
                                                        <ColumnDefinition Width="160" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="230" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="股票" FontWeight="SemiBold" Foreground="#62728A" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="策略" FontWeight="SemiBold" Foreground="#62728A" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="命中" FontWeight="SemiBold" Foreground="#62728A" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="3" Text="价格" FontWeight="SemiBold" Foreground="#62728A" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="4" Text="状态" FontWeight="SemiBold" Foreground="#62728A" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="5" Text="首次 / 最新" FontWeight="SemiBold" Foreground="#62728A" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                            <ListBox x:Name="LongTermTrackingDataGrid"
                                                     Grid.Row="1"
                                                     BorderThickness="0"
                                                     Background="#FFFFFF"
                                                     HorizontalContentAlignment="Stretch"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                        <Setter Property="Padding" Value="0" />
                                                        <Setter Property="Margin" Value="0" />
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Style.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter Property="Background" Value="#EEF5FF" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="#EEF2F7" BorderThickness="0,0,0,1" Padding="22,16" Background="Transparent">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="145" />
                                                                    <ColumnDefinition Width="230" />
                                                                    <ColumnDefinition Width="100" />
                                                                    <ColumnDefinition Width="160" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="230" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Symbol}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                                                    <TextBlock Margin="0,3,0,0" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="#62728A" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                                <Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="13,7" Background="#F1F5FF" CornerRadius="18">
                                                                    <TextBlock Text="{Binding StrategyName}" FontWeight="SemiBold" Foreground="#31517A" TextTrimming="CharacterEllipsis" />
                                                                </Border>
                                                                <TextBlock Grid.Column="2" Text="{Binding HitCountText}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                                                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding CurrentPriceText}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                                                    <TextBlock Margin="0,3,0,0" Text="{Binding ReturnFromHitText}" FontSize="13" FontWeight="SemiBold" Foreground="{Binding ReturnFromHitBrush}" />
                                                                </StackPanel>
                                                                <ItemsControl Grid.Column="4" ItemsSource="{Binding StatusTags}" VerticalAlignment="Center">

                                        <TextBlock Margin="0,6,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Text="{Binding StrategyExplanation}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StrategyExplanation}" />
                                        <TextBlock Margin="0,4,0,0" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" Text="{Binding HitTimeText}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>

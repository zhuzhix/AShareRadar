                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="每日命中" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <controls:RadarDatePicker x:Name="StockPoolHitDatePicker" Grid.Column="1" Width="138" Height="30" Margin="22,0,0,0" />
                                            <Grid Grid.Column="2" Height="30" Margin="14,0,0,0">
                                                <TextBox x:Name="DailyHitSearchBox"

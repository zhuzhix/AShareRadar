                                                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,8">
                                                        <StackPanel>
                                                            <DockPanel>
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding HeatText}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" />

                            </StackPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>

            <Border x:Name="WorkspacePanel" Grid.Column="1" Margin="14,0,0,0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0" CornerRadius="8" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Background="{DynamicResource CardDarkBrush}"
                            BorderBrush="{DynamicResource BorderBrushSoft}"
                            BorderThickness="0,0,0,1"
                            Padding="26,18"
                            CornerRadius="8,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="WorkspaceTitleText" Text="实时工作台" Style="{StaticResource PanelTitleStyle}" FontSize="22" />

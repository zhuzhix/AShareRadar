                    <Border x:Name="CapitalCard" Grid.Column="3" Margin="0,0,12,0" Padding="16,14" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0" CornerRadius="8">

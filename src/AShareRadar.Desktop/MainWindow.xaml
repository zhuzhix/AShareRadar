                        <Border x:Name="WorkspaceListHost" Grid.Row="0" Grid.Column="0" Background="{DynamicResource SoftPanelBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0" CornerRadius="0" Padding="22" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0">
                                    <TextBlock Text="研究复盘导航" Foreground="{DynamicResource MutedTextBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Visibility="Collapsed" />

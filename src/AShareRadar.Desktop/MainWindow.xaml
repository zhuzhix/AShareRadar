                                                      SelectionChanged="DailyHitFilterSelectionChanged" />
                                            <ComboBox x:Name="DailyHitStatusFilterComboBox"
                                                      Grid.Column="4"
                                                      Height="30"
                                                      Margin="14,0,0,0"
                                                      Style="{StaticResource RadarComboBoxStyle}"
                                                      SelectionChanged="DailyHitFilterSelectionChanged" />
                                            <Border Grid.Column="5" Margin="16,0,12,0" Padding="14,5" Background="{DynamicResource SoftPanelBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="15" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock x:Name="DailyHitSummaryText" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" FontWeight="SemiBold" Text="选择日期后显示当天命中的股票。" TextWrapping="NoWrap" />
                                            </Border>
                                            <Button x:Name="RefreshDailyHitsButton"
                                                    Grid.Column="6"
                                                    Width="76"
                                                    Height="30"
                                                    Margin="0"

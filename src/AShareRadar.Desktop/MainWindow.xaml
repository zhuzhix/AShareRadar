                                    <WrapPanel HorizontalAlignment="Left">
                                        <Button x:Name="SignalStreamViewButton" Width="108" Height="42" Margin="0" Padding="0" Content="信号流" Style="{StaticResource PrimaryButtonStyle}" Click="SignalStreamViewButton_Click" />
                                        <Button x:Name="SectorHeatViewButton" Width="108" Height="42" Margin="0" Padding="0" Content="行业热度" Click="SectorHeatViewButton_Click" />
                                        <Button x:Name="ConceptHeatViewButton" Width="108" Height="42" Margin="0" Padding="0" Content="概念热度" Click="ConceptHeatViewButton_Click" />
                                        <Button x:Name="MarketSentimentViewButton" Width="108" Height="42" Margin="0" Padding="0" Content="A股情绪" Visibility="Collapsed" Click="MarketSentimentViewButton_Click" />
                                        <Button x:Name="StockPoolsViewButton" Width="108" Height="42" Margin="0" Padding="0" Content="每日命中" Visibility="Collapsed" Click="StockPoolsViewButton_Click" />
                                        <Button x:Name="HistoryStatsViewButton" Width="108" Height="42" Margin="0" Padding="0" Content="历史统计" Visibility="Collapsed" Click="HistoryStatsViewButton_Click" />
                                        <Button x:Name="PredictionReviewViewButton" Width="108" Height="42" Margin="0" Padding="0" Content="次日预测" Visibility="Collapsed" Click="PredictionReviewViewButton_Click" />
                                        <Button x:Name="StrategyReviewViewButton" Width="108" Height="42" Margin="0" Padding="0" Content="策略复盘" Visibility="Collapsed" Click="StrategyReviewViewButton_Click" />

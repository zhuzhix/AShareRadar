                                                     Grid.Column="1"
                                                     Width="220"
                                                     HorizontalAlignment="Right"
                                                     Style="{StaticResource SearchTextBoxStyle}"
                                                     TextChanged="MappingHeatSearchBox_TextChanged"
                                                     ToolTip="输入行业名称进行模糊搜索" />
                                            <TextBlock Grid.Column="1"
                                                       Width="220"
                                                       Margin="13,0,0,0"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       IsHitTestVisible="False"
                                                       Text="搜索行业">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=MappingSectorSearchBox}" Value="">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <ScrollViewer Margin="0,10,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl x:Name="MappingSectorHeatItemsControl">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Padding="12,10" Margin="0,0,0,8" Background="{DynamicResource CardDarkBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8" TextElement.Foreground="{DynamicResource TextBrush}">
                                                            <StackPanel>
                                                                <DockPanel>
                                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding HeatText}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" />
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                </DockPanel>
                                                                <TextBlock Margin="0,4,0,0" Text="{Binding BreadthText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" />
                                                                <TextBlock Margin="0,4,0,0" Text="{Binding LeaderText}" Foreground="{DynamicResource WarningBrush}" FontSize="12" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </DockPanel>
                                    <DockPanel Grid.Column="2">
                                        <Grid DockPanel.Dock="Top" Height="36">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="220" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="概念热度" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBox x:Name="MappingConceptSearchBox"
                                                     Grid.Column="1"
                                                     Width="220"
                                                     HorizontalAlignment="Right"
                                                     Style="{StaticResource SearchTextBoxStyle}"
                                                     TextChanged="MappingHeatSearchBox_TextChanged"
                                                     ToolTip="输入概念名称进行模糊搜索" />
                                            <TextBlock Grid.Column="1"
                                                       Width="220"
                                                       Margin="13,0,0,0"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       IsHitTestVisible="False"
                                                       Text="搜索概念">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=MappingConceptSearchBox}" Value="">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <ScrollViewer Margin="0,10,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl x:Name="MappingConceptHeatItemsControl">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Padding="12,10" Margin="0,0,0,8" Background="{DynamicResource CardDarkBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8" TextElement.Foreground="{DynamicResource TextBrush}">
                                                            <StackPanel>
                                                                <DockPanel>
                                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding HeatText}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" />
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                </DockPanel>
                                                                <TextBlock Margin="0,4,0,0" Text="{Binding BreadthText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" />
                                                                <TextBlock Margin="0,4,0,0" Text="{Binding LeaderText}" Foreground="{DynamicResource WarningBrush}" FontSize="12" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border x:Name="KLinePanel" Grid.Row="0" Grid.Column="2" Background="#040707" BorderBrush="#303437" BorderThickness="1" CornerRadius="2" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <ScrollViewer Grid.Row="0"
                                              Margin="0"
                                              Background="#070909"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="MinutePeriodButton" Content="分时" Style="{StaticResource KLineToolbarButtonStyle}" Click="MinutePeriodButton_Click" />
                                        <Button x:Name="FiveDayPeriodButton" Content="5日" Style="{StaticResource KLineToolbarButtonStyle}" Click="FiveDayPeriodButton_Click" />
                                        <Button x:Name="M1PeriodButton" Content="1分" Style="{StaticResource KLineToolbarButtonStyle}" Click="M1PeriodButton_Click" />
                                        <Button x:Name="M5PeriodButton" Content="5分" Style="{StaticResource KLineToolbarButtonStyle}" Click="M5PeriodButton_Click" />
                                        <Button x:Name="M15PeriodButton" Content="15分" Style="{StaticResource KLineToolbarButtonStyle}" Click="M15PeriodButton_Click" />
                                        <Button x:Name="M30PeriodButton" Content="30分" Style="{StaticResource KLineToolbarButtonStyle}" Click="M30PeriodButton_Click" />
                                        <Button x:Name="M60PeriodButton" Content="60分" Style="{StaticResource KLineToolbarButtonStyle}" Click="M60PeriodButton_Click" />
                                        <Button x:Name="DayPeriodButton" Content="日线" Style="{StaticResource KLineToolbarSelectedButtonStyle}" Click="DayPeriodButton_Click" />
                                        <Button x:Name="WeekPeriodButton" Content="周线" Style="{StaticResource KLineToolbarButtonStyle}" Click="WeekPeriodButton_Click" />
                                        <Button x:Name="MonthPeriodButton" Content="月线" Style="{StaticResource KLineToolbarButtonStyle}" Click="MonthPeriodButton_Click" />
                                        <Button x:Name="MacdIndicatorButton" Content="MACD" Style="{StaticResource KLineToolbarSelectedButtonStyle}" Click="MacdIndicatorButton_Click" />
                                        <Button x:Name="KdjIndicatorButton" Content="KDJ" Style="{StaticResource KLineToolbarButtonStyle}" Click="KdjIndicatorButton_Click" />
                                        <Button x:Name="RsiIndicatorButton" Content="RSI" Style="{StaticResource KLineToolbarButtonStyle}" Click="RsiIndicatorButton_Click" />
                                        <Button x:Name="TrainingMarkerButton" Content="训练" Style="{StaticResource KLineToolbarButtonStyle}" Click="TrainingMarkerButton_Click" />
                                    </StackPanel>
                                </ScrollViewer>

                                <StackPanel Grid.Row="1" Margin="6,4,6,2">
                                    <TextBlock x:Name="ChartTitleText" Text="K线分析" Foreground="#DCE3EA" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="ChartCaptionText" Margin="0,2,0,0" Foreground="#69747A" FontSize="11" Text="选择左侧机会后显示对应个股走势、均线、成交量、MACD 与筹码分布。" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <Grid Grid.Row="2">
                                    <controls:KLineChartControl x:Name="KLineChart"
                                                                 SymbolName="未选择"
                                                                 PeriodName="日线" />
                                    <controls:IntradayChartControl x:Name="IntradayChart"
                                                                    SymbolName="未选择"
                                                                    Visibility="Collapsed" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>

            <Border x:Name="SnapshotPanel" Grid.Column="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="7" Padding="14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="个股快照" Style="{StaticResource PanelTitleStyle}" />
                        <TextBlock Margin="0,3,0,0" Style="{StaticResource CaptionStyle}" Text="策略依据 · 风险 · 人工判断" />
                    </StackPanel>
                    <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="SnapshotTitleText" FontSize="20" FontWeight="SemiBold" Text="未选择机会" />
                            <TextBlock x:Name="SnapshotStatusText" Margin="0,10,0,0" Foreground="{DynamicResource MutedTextBrush}" Text="请先在左侧选择一个机会。" TextWrapping="Wrap" />
                            <TextBlock x:Name="SnapshotTimeText" Margin="0,8,0,0" Foreground="{DynamicResource SubtleTextBrush}" Text="" TextWrapping="Wrap" />

                            <TextBlock Margin="0,18,0,0" Text="人工判断" FontWeight="SemiBold" />
                            <WrapPanel Margin="0,8,0,0">
                                <Button x:Name="WatchButton" Width="76" Content="观察" Click="WatchButton_Click" />
                                <Button x:Name="FocusButton" Width="76" Content="重点" Style="{StaticResource PrimaryButtonStyle}" Click="FocusButton_Click" />
                                <Button x:Name="WaitPullbackButton" Width="86" Content="等回踩" Click="WaitPullbackButton_Click" />
                                <Button x:Name="GiveUpButton" Width="76" Content="放弃" Style="{StaticResource DangerButtonStyle}" Click="GiveUpButton_Click" />
                            </WrapPanel>
                            <TextBox x:Name="DecisionNoteTextBox" Margin="0,6,0,0" Height="68"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" />
                            <TextBlock x:Name="ManualTagText" Margin="0,8,0,0" Foreground="{DynamicResource MutedTextBrush}" Text="人工标记：--" TextWrapping="Wrap" />

                            <TextBlock Margin="0,18,0,0" Text="最新理由" FontWeight="SemiBold" />
                            <TextBlock x:Name="SnapshotReasonText" Margin="0,8,0,0" Foreground="{DynamicResource MutedTextBrush}" Text="--" TextWrapping="Wrap" />
                            <Border x:Name="SnapshotSentimentPanel" Margin="0,14,0,0" Padding="16" Background="{DynamicResource CardDarkBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" TextElement.Foreground="{DynamicResource TextBrush}">
                                <StackPanel>
                                    <TextBlock Text="情绪因子" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" />
                                    <TextBlock x:Name="SnapshotSentimentText" Margin="0,5,0,0" Foreground="{DynamicResource MutedTextBrush}" Text="--" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <TextBlock Margin="0,18,0,0" Text="风险提示" FontWeight="SemiBold" />
                            <TextBlock x:Name="SnapshotRiskText" Margin="0,8,0,0" Foreground="{DynamicResource WarningBrush}" Text="--" TextWrapping="Wrap" />

                            <TextBlock Margin="0,18,0,0" Text="命中策略" FontWeight="SemiBold" />
                            <ItemsControl x:Name="StrategyHitItemsControl" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" Padding="16" Background="{DynamicResource CardDarkBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" TextElement.Foreground="{DynamicResource TextBrush}">
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold">
                                                    <Run Text="{Binding StrategyName}" />
                                                    <Run Text="   分数 " />
                                                    <Run Text="{Binding Score}" />
                                                </TextBlock>
                                                <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource PrimaryBrush}" FontSize="12" FontWeight="SemiBold" Text="{Binding SentimentText}" TextWrapping="Wrap" />
                                                <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Text="{Binding Reason}" TextWrapping="Wrap" />
                                                <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource WarningBrush}" FontSize="12" Text="{Binding Risk}" TextWrapping="Wrap" />
                                                <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource SuccessBrush}" FontSize="12" Text="{Binding PassedConditionsText}" TextWrapping="Wrap" />
                                                <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource WarningBrush}" FontSize="12" Text="{Binding FailedConditionsText}" TextWrapping="Wrap" />
                                                <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource TextBrush}" FontSize="12" Text="{Binding TradePlanText}" TextWrapping="Wrap" />
                                                <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource SubtleTextBrush}" FontSize="12" Text="{Binding TagsText}" TextWrapping="Wrap" />
                                                <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource SubtleTextBrush}" FontSize="12" Text="{Binding MetricsText}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="FooterText" Margin="22,7,22,0" Foreground="{DynamicResource SubtleTextBrush}" Text="后端：http://127.0.0.1:18730" />
        </Border>
    </Grid>
</Window>





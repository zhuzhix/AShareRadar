                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" Padding="10" Background="#F8FAFC" BorderBrush="#E3EAF1" BorderThickness="1" CornerRadius="5">
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold">
                                                    <Run Text="{Binding StrategyName}" />
                                                    <Run Text="   分数 " />
                                                    <Run Text="{Binding Score}" />
                                                </TextBlock>
                                                <TextBlock Margin="0,5,0,0" Foreground="{StaticResource PrimaryBrush}" FontSize="12" FontWeight="SemiBold" Text="{Binding SentimentText}" TextWrapping="Wrap" />
                                                <TextBlock Margin="0,5,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Text="{Binding Reason}" TextWrapping="Wrap" />
                                                <TextBlock Margin="0,5,0,0" Foreground="#9A5B00" FontSize="12" Text="{Binding Risk}" TextWrapping="Wrap" />
                                                <TextBlock Margin="0,5,0,0" Foreground="#0F7A3A" FontSize="12" Text="{Binding PassedConditionsText}" TextWrapping="Wrap" />
                                                <TextBlock Margin="0,5,0,0" Foreground="#9A5B00" FontSize="12" Text="{Binding FailedConditionsText}" TextWrapping="Wrap" />
                                                <TextBlock Margin="0,5,0,0" Foreground="{StaticResource TextBrush}" FontSize="12" Text="{Binding TradePlanText}" TextWrapping="Wrap" />
                                                <TextBlock Margin="0,5,0,0" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" Text="{Binding TagsText}" TextWrapping="Wrap" />
                                                <TextBlock Margin="0,5,0,0" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" Text="{Binding MetricsText}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="FooterText" Margin="22,7,22,0" Foreground="{StaticResource SubtleTextBrush}" Text="后端：http://127.0.0.1:18730" />
        </Border>
    </Grid>
</Window>




                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Click="RefreshDailyHitsButton_Click" />
                                        </Grid>
                                    </Border>

                                    <Border Grid.Row="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="0" Margin="0,16,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <DataGrid x:Name="DailyHitDataGrid"
                                                      Grid.Row="0"
                                                      Style="{StaticResource ReviewDataGridStyle}"
                                                      Margin="0"
                                                      AutoGenerateColumns="False"
                                                      IsReadOnly="True"
                                                      CanUserAddRows="False"
                                                      CanUserDeleteRows="False"
                                                      CanUserReorderColumns="True"
                                                      CanUserResizeColumns="True"
                                                      CanUserSortColumns="True"
                                                      HeadersVisibility="Column"
                                                      GridLinesVisibility="Horizontal"
                                                      HorizontalGridLinesBrush="{DynamicResource BorderBrushSoft}"
                                                      BorderThickness="0"
                                                      Background="{DynamicResource CardBrush}"
                                                      RowBackground="{DynamicResource CardBrush}"
                                                       AlternatingRowBackground="{DynamicResource TableAltRowBrush}"
                                                       AlternationCount="2"
                                                       RowHeight="48"
                                                       ColumnHeaderHeight="40"
                                                      SelectionMode="Single"
                                                      SelectionUnit="FullRow"
                                                      EnableRowVirtualization="True"
                                                      EnableColumnVirtualization="True"
                                                      VirtualizingPanel.IsVirtualizing="True"
                                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                                      ScrollViewer.CanContentScroll="True"
                                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                      SelectionChanged="DailyHitDataGrid_SelectionChanged">
                                                <DataGrid.Resources>
                                                    <Style TargetType="DataGridColumnHeader">
                                                        <Setter Property="Background" Value="{DynamicResource SoftPanelBrush}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}" />
                                                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                                                        <Setter Property="Padding" Value="10,0" />
                                                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                                                    </Style>
                                                    <Style TargetType="DataGridCell">
                                                        <Setter Property="BorderThickness" Value="0" />
                                                        <Setter Property="Padding" Value="10,0" />
                                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                        <Style.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource TableSelectedBrush}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                    <Style TargetType="DataGridRow">
                                                        <Setter Property="BorderThickness" Value="0" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                        <Setter Property="Cursor" Value="Hand" />
                                                        <Style.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource TableSelectedBrush}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource TableHoverBrush}" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGrid.Resources>
                                                <DataGrid.Columns>
                                                    <DataGridTemplateColumn Header="股票" Width="2*" MinWidth="150" SortMemberPath="Symbol">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Margin="0,2,0,0" Text="{Binding Symbol}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" FontWeight="SemiBold" />
                                                                    </StackPanel>
                                                                    <Button Grid.Column="1"
                                                                            Style="{StaticResource CopySymbolButtonStyle}"
                                                                            Tag="{Binding Symbol}"
                                                                            Click="CopyOpportunitySymbolButton_Click">
                                                                        <Grid Width="14" Height="14">
                                                                            <Border Width="8" Height="8" Margin="0,0,1,1" HorizontalAlignment="Right" VerticalAlignment="Bottom" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" BorderThickness="1.2" CornerRadius="1" />
                                                                            <Border Width="8" Height="8" Margin="1,1,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource CardBrush}" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" BorderThickness="1.2" CornerRadius="1" />
                                                                        </Grid>
                                                                    </Button>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTextColumn Header="最新命中" Binding="{Binding LatestHitTimeText}" SortMemberPath="EventTime" Width="*" MinWidth="100" />
                                                    <DataGridTemplateColumn Header="主策略" Width="2*" MinWidth="160" SortMemberPath="StrategyName">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Border Padding="10,3" Background="{DynamicResource PrimarySoftBrush}" CornerRadius="10" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding StrategyName}" Foreground="{DynamicResource AccentBlueBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTextColumn Header="策略数" Binding="{Binding StrategyCount}" SortMemberPath="StrategyCount" Width="*" MinWidth="72" />
                                                    <DataGridTextColumn Header="命中次数" Binding="{Binding HitCount}" SortMemberPath="HitCount" Width="*" MinWidth="82" />
                                                    <DataGridTextColumn Header="强度" Binding="{Binding ScoreText}" SortMemberPath="Score" Width="*" MinWidth="82" />
                                                    <DataGridTextColumn Header="命中价" Binding="{Binding PriceText}" SortMemberPath="Price" Width="*" MinWidth="86" />
                                                    <DataGridTemplateColumn Header="事件" Width="*" MinWidth="110" SortMemberPath="EventTypeText">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Border Padding="10,3" Background="{DynamicResource PrimarySoftBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="?" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold" Margin="0,0,4,0" />
                                                                        <TextBlock Text="{Binding EventTypeText}" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="人工状态" Width="*" MinWidth="120" SortMemberPath="ManualStatusText">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Border Padding="10,3" Background="{DynamicResource SoftPanelBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="?" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,4,0" />
                                                                        <TextBlock Text="{Binding ManualStatusText}" Foreground="{DynamicResource MutedTextBrush}" FontWeight="SemiBold" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="操作" Width="*" MinWidth="62">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Button Content="K"
                                                                        Style="{StaticResource DailyHitKLineButtonStyle}"
                                                                        Click="OpenOpportunityKLineButton_Click" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <Border Grid.Row="1" Margin="0,16,0,0" Padding="22,18" Background="{DynamicResource CardDarkBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1,1,0,0" CornerRadius="0,0,12,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*" />
                                                        <ColumnDefinition Width="40" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding SelectedItem.Name, ElementName=DailyHitDataGrid, TargetNullValue=未选择}" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Margin="10,3,0,0" FontSize="13" Foreground="{DynamicResource MutedTextBrush}" FontWeight="SemiBold" Text="{Binding SelectedItem.Symbol, ElementName=DailyHitDataGrid, TargetNullValue=--}" VerticalAlignment="Center" />
                                                            <Border Grid.Column="2" Margin="14,0,0,0" Padding="10,3" Background="{DynamicResource PrimarySoftBrush}" CornerRadius="10" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding SelectedItem.StrategyName, ElementName=DailyHitDataGrid, TargetNullValue=--}" Foreground="{DynamicResource AccentBlueBrush}" FontWeight="SemiBold" />
                                                            </Border>
                                                            <TextBlock Grid.Column="3" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Text="命中策略" />
                                                        </Grid>
                                                        <TextBlock Margin="0,16,0,0" Foreground="{DynamicResource TextBrush}" Text="{Binding SelectedItem.Reason, ElementName=DailyHitDataGrid, TargetNullValue=--}" TextWrapping="Wrap" MaxHeight="68" />
                                                        <TextBlock Margin="0,10,0,0" Foreground="{DynamicResource MutedTextBrush}" Text="{Binding SelectedItem.StrategyText, ElementName=DailyHitDataGrid, TargetNullValue=--}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="风险与处理" Foreground="{DynamicResource MutedTextBrush}" FontWeight="SemiBold" />
                                                        <Border Margin="0,12,0,0" Padding="16,10" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12">
                                                            <TextBlock Foreground="{DynamicResource DangerBrush}" Text="{Binding SelectedItem.RiskText, ElementName=DailyHitDataGrid, TargetNullValue=--}" TextWrapping="Wrap" MaxHeight="58" />
                                                        </Border>
                                                        <Border Margin="0,10,0,0" Padding="14,7" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12">
                                                            <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="{Binding SelectedItem.ReviewText, ElementName=DailyHitDataGrid, TargetNullValue=--}" TextWrapping="Wrap" />
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border x:Name="ObservationPoolPanel" Grid.Row="0" Grid.Column="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0" CornerRadius="0,0,8,8" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="0" />
                                    <RowDefinition Height="0" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="概念与行业映射" FontSize="17" FontWeight="SemiBold" />
                                        <TextBlock x:Name="MappingPageStateText" DockPanel.Dock="Right" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" Visibility="Collapsed" />
                                    </DockPanel>
                                    <TextBlock x:Name="MappingPageSummaryText" Margin="0,5,0,0" Foreground="{DynamicResource MutedTextBrush}" Text="行业映射 -- | 概念映射 -- | 尚无更新时间" />
                                    <TextBlock x:Name="MappingPageErrorText" Margin="0,5,0,0" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                                </StackPanel>
                                <GridSplitter Grid.Row="2"
                                              Height="6"
                                              Visibility="Collapsed"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"
                                              Background="Transparent"
                                              ResizeDirection="Rows"
                                              ResizeBehavior="PreviousAndNext"
                                              Cursor="SizeNS" />
                                <Grid Grid.Row="3" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <DockPanel Grid.Column="0">
                                        <Grid DockPanel.Dock="Top" Height="36">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="220" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="行业热度" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />

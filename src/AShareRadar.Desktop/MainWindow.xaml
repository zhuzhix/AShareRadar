                    </StackPanel>

                    <Grid Margin="0,8,0,0">
                        <ListBox x:Name="OpportunityListBox" SelectionChanged="OpportunityListBox_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8" Padding="12,11" TextElement.Foreground="{DynamicResource TextBrush}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold">
                                                <Run Text="{Binding Symbol}" />
                                            </TextBlock>
                                            <Button Grid.Column="1"
                                                    Style="{StaticResource CopySymbolButtonStyle}"
                                                    Tag="{Binding Symbol}"
                                                    Click="CopyOpportunitySymbolButton_Click">
                                                <Grid Width="14" Height="14">
                                                    <Border Width="8" Height="8"
                                                            Margin="0,0,1,1"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Bottom"
                                                            BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                            BorderThickness="1.2"
                                                            CornerRadius="1" />
                                                    <Border Width="8" Height="8"
                                                            Margin="1,1,0,0"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Top"
                                                            Background="{DynamicResource SoftPanelBrush}"
                                                            BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                            BorderThickness="1.2"
                                                            CornerRadius="1" />
                                                    </Grid>
                                                </Button>
                                            <Button Grid.Column="2"
                                                    Width="28"
                                                    Height="22"
                                                    Margin="0,0,6,0"
                                                    Padding="0"
                                                    Background="{DynamicResource PrimarySoftBrush}"
                                                    Foreground="{DynamicResource PrimaryBrush}"
                                                    ToolTip="打开K线窗口"
                                                    Click="OpenOpportunityKLineButton_Click">
                                                <TextBlock Text="K" FontSize="12" FontWeight="SemiBold" />
                                            </Button>
                                            <TextBlock Grid.Column="3"
                                                       VerticalAlignment="Center"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="4"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding ScoreText}"
                                                       Foreground="{DynamicResource PrimaryBrush}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold" />
                                        </Grid>
                                        <DockPanel Margin="0,6,0,0" LastChildFill="True">
                                            <Border DockPanel.Dock="Left" Height="20" Padding="7,0" Margin="0,0,8,0" Background="{DynamicResource PrimarySoftBrush}" CornerRadius="4">
                                                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource PrimaryBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" VerticalAlignment="Center">
                                                <Run Text="命中 " />
                                                <Run Text="{Binding HitCount}" />
                                                <Run Text=" 次" />
                                            </TextBlock>
                                            <TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="12" FontWeight="SemiBold" Text="{Binding StrategySummary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Text="{Binding StrategyExplanation}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StrategyExplanation}" />
                                        <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" Text="{Binding HitTimeText}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border Padding="18"
                                Background="{DynamicResource CardDarkBrush}"
                                BorderBrush="{DynamicResource BorderBrushSoft}"

        </Border>

        <Grid Grid.Row="2" Margin="20,14,20,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OpportunityColumn" Width="430" />
                <ColumnDefinition x:Name="WorkspaceColumn" Width="*" />
                <ColumnDefinition x:Name="SnapshotColumn" Width="328" />
            </Grid.ColumnDefinitions>

            <Border x:Name="OpportunityPanel" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0" CornerRadius="8" Padding="16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="实时池" Style="{StaticResource PanelTitleStyle}" />

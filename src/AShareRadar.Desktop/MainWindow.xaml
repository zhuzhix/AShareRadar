                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource ReviewCardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="待处理" Foreground="{DynamicResource MutedTextBrush}" FontWeight="SemiBold" />
                                                <TextBlock x:Name="DailyHitPendingMetricText" Margin="0,8,0,0" Text="0" Foreground="{DynamicResource DangerBrush}" FontSize="28" FontWeight="SemiBold" />

                            </StackPanel>
                            <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                <Border Style="{StaticResource ReviewPillStyle}" Margin="0,0,10,0">
                                    <TextBlock Text="复盘工作台" Foreground="{DynamicResource MutedTextBrush}" FontWeight="SemiBold" />
                                </Border>
                                <Border Style="{StaticResource ReviewPillStyle}">
                                    <TextBlock Text="明暗主题可切换" Foreground="{DynamicResource MutedTextBrush}" FontWeight="SemiBold" />

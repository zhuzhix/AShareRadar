                                                        <Run Text="{Binding Symbol}" />
                                                        <Run Text=" " />
                                                        <Run Text="{Binding Name}" />
                                                    </TextBlock>
                                                    <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Text="{Binding StrategyName}" TextWrapping="Wrap" />
                                                    <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource SubtleTextBrush}" FontSize="12" Text="{Binding Reason}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <ScrollViewer x:Name="SectorHeatPanel" Grid.Row="1" Margin="0,10,0,0" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

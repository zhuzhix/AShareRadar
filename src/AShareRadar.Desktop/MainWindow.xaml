                                                    <Button x:Name="UseSelectedSymbolFilterButton" Width="84" Height="30" Padding="0" Content="当前股票" Click="UseSelectedSymbolFilterButton_Click" />
                                                    <Button x:Name="ClearHistoryFilterButton" Width="76" Height="30" Padding="0" Content="清空" Click="ClearHistoryFilterButton_Click" />
                                                </StackPanel>
                                            </WrapPanel>
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Row="1" Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="320" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Column="0" Grid.Row="0" Text="策略表现" FontWeight="SemiBold" />
                                        <ListBox x:Name="HistoryStrategyListBox" Grid.Column="0" Grid.Row="1" Margin="0,8,0,0" ItemContainerStyle="{StaticResource FlatListBoxItemStyle}" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource ReviewAccordionCardStyle}" HorizontalAlignment="Stretch" TextElement.Foreground="{DynamicResource TextBrush}">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="72" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding StrategyName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LastHitTime}" Foreground="{DynamicResource SubtleTextBrush}" FontSize="12" HorizontalAlignment="Right" />
                                                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0" Text="{Binding SummaryText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <TextBlock Grid.Column="2" Grid.Row="0" Text="历史信号" FontWeight="SemiBold" />
                                        <ListBox x:Name="HistorySignalListBox" Grid.Column="2" Grid.Row="1" Margin="0,8,0,0" ItemContainerStyle="{StaticResource FlatListBoxItemStyle}" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource ReviewAccordionCardStyle}" HorizontalAlignment="Stretch" TextElement.Foreground="{DynamicResource TextBrush}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="90" />
                                                                <ColumnDefinition Width="96" />
                                                                <ColumnDefinition Width="170" />
                                                                <ColumnDefinition Width="*" MinWidth="260" />
                                                                <ColumnDefinition Width="96" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="{Binding EventTime}" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding EventType}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="2" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ClipToBounds="True">
                                                                <Run Text="{Binding Symbol}" />
                                                                <Run Text=" " />
                                                                <Run Text="{Binding Name}" />
                                                            </TextBlock>
                                                            <StackPanel Grid.Column="3" ClipToBounds="True">
                                                                <TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis">
                                                                    <Run Text="{Binding StrategyName}" />
                                                                    <Run Text="   " />
                                                                    <Run Text="{Binding HitText}" />
                                                                </TextBlock>
                                                                <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource SubtleTextBrush}" FontSize="12" Text="{Binding Reason}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="4" Text="{Binding ScoreText}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Grid>

                                <ScrollViewer x:Name="StrategyCenterPanel" Grid.Row="1" Margin="0,10,0,0" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <StackPanel HorizontalAlignment="Stretch" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                                        <Border Style="{StaticResource ReviewFilterBarStyle}">
                                            <StackPanel>
                                                <TextBlock Text="策略中心" FontSize="18" FontWeight="SemiBold" />
                                                <TextBlock x:Name="StrategyCenterSummaryText" Margin="0,8,0,0" Foreground="{DynamicResource MutedTextBrush}" Text="暂无策略数据" TextWrapping="Wrap" />
                                                <TextBlock x:Name="StrategySentimentRulesText" Margin="0,8,0,0" Foreground="{DynamicResource PrimaryBrush}" Text="情绪规则：等待加载" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                        <Border Margin="0,10,0,0" Style="{StaticResource ReviewSectionHeaderStyle}">
                                            <StackPanel>
                                                <TextBlock Text="情绪因子" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" />
                                                <TextBlock Margin="0,6,0,0"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="12"
                                                           Text="实时扫描和策略回放会把 A股情绪温度写入信号：冰点/偏冷降低进攻型信号，偏热增强主线与强趋势，过热降低高位进攻并提示拥挤风险。"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <ListBox x:Name="StrategyDefinitionListBox" Margin="0,10,0,0" ItemContainerStyle="{StaticResource FlatListBoxItemStyle}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="16">
                                                        <StackPanel>
                                                            <DockPanel>
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding DefaultActionText}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" />
                                                                <TextBlock FontWeight="SemiBold">
                                                                    <Run Text="{Binding Name}" />
                                                                    <Run Text="  " />
                                                                    <Run Text="{Binding Code}" />
                                                                </TextBlock>
                                                            </DockPanel>
                                                            <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Text="{Binding StageText}" TextWrapping="Wrap" />
                                                            <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource SubtleTextBrush}" FontSize="12" Text="{Binding DataRequirementText}" TextWrapping="Wrap" />
                                                            <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource SubtleTextBrush}" FontSize="12" Text="{Binding ParameterText}" TextWrapping="Wrap" />
                                                            <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Text="{Binding Description}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </ScrollViewer>

                                <Grid x:Name="StrategyReviewPanel" Grid.Row="1" Margin="0,10,0,0" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Style="{StaticResource ReviewFilterBarStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="策略复盘中心" FontSize="18" FontWeight="SemiBold" />
                                                <TextBlock x:Name="StrategyReviewSummaryText" Margin="0,8,0,0" Foreground="{DynamicResource MutedTextBrush}" Text="集中查看收益统计、命中明细、热度快照和策略版本。" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <StackPanel Margin="0,0,10,0">
                                                    <TextBlock Text="开始" Style="{StaticResource CaptionStyle}" />
                                                    <controls:RadarDatePicker x:Name="StrategyReviewFromDatePicker" Width="128" Height="30" Margin="0,4,0,0" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,10,0">
                                                    <TextBlock Text="结束" Style="{StaticResource CaptionStyle}" />
                                                    <controls:RadarDatePicker x:Name="StrategyReviewToDatePicker" Width="128" Height="30" Margin="0,4,0,0" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,10,0">
                                                    <TextBlock Text="策略" Style="{StaticResource CaptionStyle}" />
                                                    <TextBox x:Name="StrategyReviewStrategyCodeTextBox" Width="160" Height="30" Margin="0,4,0,0" Style="{StaticResource SearchTextBoxStyle}" ToolTip="策略代码，留空查询全部" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,10,0">
                                                    <TextBlock Text="版本" Style="{StaticResource CaptionStyle}" />
                                                    <TextBox x:Name="StrategyReviewVersionTextBox" Width="190" Height="30" Margin="0,4,0,0" Style="{StaticResource SearchTextBoxStyle}" ToolTip="策略版本，留空查询全部" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,10,0">
                                                    <TextBlock Text="周期" Style="{StaticResource CaptionStyle}" />
                                                    <ComboBox x:Name="StrategyReviewHorizonComboBox" Width="94" Height="30" Margin="0,4,0,0" SelectedIndex="0" Style="{StaticResource RadarComboBoxStyle}">
                                                        <ComboBoxItem Content="全部" Tag="" />
                                                        <ComboBoxItem Content="D1" Tag="D1" />
                                                        <ComboBoxItem Content="D3" Tag="D3" />
                                                        <ComboBoxItem Content="D5" Tag="D5" />
                                                        <ComboBoxItem Content="W1" Tag="W1" />
                                                        <ComboBoxItem Content="M1" Tag="M1" />
                                                        <ComboBoxItem Content="M3" Tag="M3" />
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                                    <Button x:Name="RefreshStrategyReviewButton" Width="72" Height="30" Padding="8,0" Content="查询" Style="{StaticResource PrimaryButtonStyle}" Click="RefreshStrategyReviewButton_Click" />
                                                    <Button x:Name="RecalculateStrategyReviewButton" Width="78" Height="30" Padding="8,0" Content="重算" Click="RecalculateStrategyReviewButton_Click" />
                                                </StackPanel>
                                            </WrapPanel>
                                        </Grid>
                                    </Border>

                                    <UniformGrid Grid.Row="1" Columns="5" Margin="0,16,0,0">
                                        <Border Style="{StaticResource ReviewCardStyle}" Margin="0,0,12,0">
                                            <StackPanel>
                                                <TextBlock Text="样本数" Foreground="{DynamicResource MutedTextBrush}" FontWeight="SemiBold" />
                                                <TextBlock x:Name="StrategyReviewSignalMetricText" Margin="0,8,0,0" Text="0" Foreground="{DynamicResource PrimaryBrush}" FontSize="28" FontWeight="SemiBold" />
                                                <TextBlock Text="命中记录" Foreground="{DynamicResource MutedTextBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource ReviewCardStyle}" Margin="0,0,12,0">
                                            <StackPanel>
                                                <TextBlock Text="已完成" Foreground="{DynamicResource MutedTextBrush}" FontWeight="SemiBold" />
                                                <TextBlock x:Name="StrategyReviewCompletedMetricText" Margin="0,8,0,0" Text="0" Foreground="{DynamicResource AccentBlueBrush}" FontSize="28" FontWeight="SemiBold" />
                                                <TextBlock Text="可统计样本" Foreground="{DynamicResource MutedTextBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource ReviewCardStyle}" Margin="0,0,12,0">
                                            <StackPanel>
                                                <TextBlock Text="胜率" Foreground="{DynamicResource MutedTextBrush}" FontWeight="SemiBold" />
                                                <TextBlock x:Name="StrategyReviewWinRateMetricText" Margin="0,8,0,0" Text="--" Foreground="{DynamicResource SuccessBrush}" FontSize="28" FontWeight="SemiBold" />
                                                <TextBlock Text="按已完成样本" Foreground="{DynamicResource MutedTextBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource ReviewCardStyle}" Margin="0,0,12,0">
                                            <StackPanel>
                                                <TextBlock Text="平均收益" Foreground="{DynamicResource MutedTextBrush}" FontWeight="SemiBold" />
                                                <TextBlock x:Name="StrategyReviewAverageMetricText" Margin="0,8,0,0" Text="--" Foreground="{DynamicResource DangerBrush}" FontSize="28" FontWeight="SemiBold" />
                                                <TextBlock Text="目标窗口" Foreground="{DynamicResource MutedTextBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource ReviewCardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="策略版本" Foreground="{DynamicResource MutedTextBrush}" FontWeight="SemiBold" />
                                                <TextBlock x:Name="StrategyReviewVersionMetricText" Margin="0,8,0,0" Text="0" Foreground="{DynamicResource WarningBrush}" FontSize="28" FontWeight="SemiBold" />
                                                <TextBlock Text="已登记版本" Foreground="{DynamicResource MutedTextBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <Grid Grid.Row="2" Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="2*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="16" />
                                            <RowDefinition Height="260" />
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="0">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Margin="18,14,18,10" Text="收益统计" FontWeight="SemiBold" />
                                                <DataGrid x:Name="StrategyReturnSummaryDataGrid" Grid.Row="1" Style="{StaticResource ReviewDataGridStyle}" RowHeight="46">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="策略" Binding="{Binding StrategyName}" Width="2*" MinWidth="160" />
                                                        <DataGridTextColumn Header="版本" Binding="{Binding StrategyVersionText}" Width="2*" MinWidth="150" />
                                                        <DataGridTextColumn Header="周期" Binding="{Binding HorizonText}" Width="*" MinWidth="70" />
                                                        <DataGridTextColumn Header="命中" Binding="{Binding SignalCountText}" Width="*" MinWidth="70" />
                                                        <DataGridTextColumn Header="胜率" Binding="{Binding WinRateText}" Width="*" MinWidth="80" />
                                                        <DataGridTemplateColumn Header="平均收益" Width="*" MinWidth="90">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding AverageReturnText}" Foreground="{Binding AverageReturnBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                        <DataGridTemplateColumn Header="最好/最差" Width="2*" MinWidth="150">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding RangeText}" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                        <DataGridTextColumn Header="最近命中" Binding="{Binding LastSignalTimeText}" Width="*" MinWidth="110" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </Grid>
                                        </Border>

                                        <Border Grid.Row="0" Grid.Column="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="0">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Margin="18,14,18,10" Text="策略版本" FontWeight="SemiBold" />
                                                <ListBox x:Name="StrategyVersionListBox" Grid.Row="1" Margin="14,0,14,14" ItemContainerStyle="{StaticResource FlatListBoxItemStyle}">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{StaticResource ReviewAccordionCardStyle}">
                                                                <StackPanel>
                                                                    <DockPanel>
                                                                        <Border DockPanel.Dock="Right" Padding="8,3" Background="{Binding StatusBackground}" CornerRadius="10">
                                                                            <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="12" FontWeight="SemiBold" />
                                                                        </Border>
                                                                        <TextBlock Text="{Binding StrategyName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                    </DockPanel>
                                                                    <TextBlock Margin="0,5,0,0" Text="{Binding Version}" Foreground="{DynamicResource PrimaryBrush}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                    <TextBlock Margin="0,5,0,0" Text="{Binding TimeText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" />
                                                                    <TextBlock Margin="0,5,0,0" Text="{Binding RuleSummary}" Foreground="{DynamicResource SubtleTextBrush}" FontSize="12" TextWrapping="Wrap" MaxHeight="54" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </Grid>
                                        </Border>

                                        <Border Grid.Row="2" Grid.Column="0" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="0">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Margin="18,14,18,10" Text="命中明细" FontWeight="SemiBold" />
                                                <DataGrid x:Name="StrategyReturnRecordDataGrid" Grid.Row="1" Style="{StaticResource ReviewDataGridStyle}" RowHeight="46" SelectionChanged="StrategyReturnRecordDataGrid_SelectionChanged">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="股票" Binding="{Binding StockText}" Width="2*" MinWidth="140" />
                                                        <DataGridTextColumn Header="策略" Binding="{Binding StrategyName}" Width="2*" MinWidth="160" />
                                                        <DataGridTextColumn Header="版本" Binding="{Binding StrategyVersionText}" Width="2*" MinWidth="140" />
                                                        <DataGridTextColumn Header="命中" Binding="{Binding EventTimeText}" Width="*" MinWidth="118" />
                                                        <DataGridTextColumn Header="入场" Binding="{Binding EntryPriceText}" Width="*" MinWidth="76" />
                                                        <DataGridTemplateColumn Header="收益" Width="*" MinWidth="82">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding ReturnText}" Foreground="{Binding ReturnBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                        <DataGridTextColumn Header="区间" Binding="{Binding RangeText}" Width="2*" MinWidth="150" />
                                                        <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="*" MinWidth="78" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </Grid>
                                        </Border>

                                        <Border Grid.Row="2" Grid.Column="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="18">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="14" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="热度快照" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="StrategyReviewHeatSummaryText" Margin="0,6,0,0" Text="等待加载最新热度快照" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" />
                                                    <ItemsControl x:Name="StrategyReviewSectorHeatItemsControl" Margin="0,10,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Margin="0,0,0,8" Padding="10,8" Background="{DynamicResource CardDarkBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8">
                                                                    <StackPanel>
                                                                        <DockPanel>
                                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding HeatText}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" />
                                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                        </DockPanel>
                                                                        <TextBlock Margin="0,4,0,0" Text="{Binding BreadthText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="命中证据" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="StrategyReviewSelectedSignalText" Margin="0,6,0,0" Text="选择一条命中明细后显示热度上下文和版本绑定。" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" />
                                                    <ItemsControl x:Name="StrategyReviewSignalEvidenceItemsControl" Margin="0,10,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Margin="0,0,0,8" Padding="10,8" Background="{DynamicResource CardDarkBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8">
                                                                    <StackPanel>
                                                                        <DockPanel>
                                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding HeatText}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" />
                                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                        </DockPanel>
                                                                        <TextBlock Margin="0,4,0,0" Text="{Binding BreadthText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>

                                <ScrollViewer x:Name="BacktestPanel" Grid.Row="1" Margin="0,10,0,0" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <StackPanel HorizontalAlignment="Stretch" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                                        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="18">
                                            <StackPanel>
                                                <TextBlock Text="策略回放" FontSize="18" FontWeight="SemiBold" />
                                                <TextBlock x:Name="BacktestSummaryText" Margin="0,8,0,0" Foreground="{DynamicResource MutedTextBrush}" Text="输入股票和区间后执行回放。" TextWrapping="Wrap" />
                                                <TextBlock Margin="0,10,0,0" Text="回放范围" Style="{StaticResource CaptionStyle}" />
                                                <ComboBox x:Name="BacktestStockPoolComboBox" Margin="0,6,0,0" Height="30" SelectedIndex="0">
                                                    <ComboBoxItem Content="手动输入" />
                                                    <ComboBoxItem Content="历史库前N只" />
                                                    <ComboBoxItem Content="最近活跃池" />
                                                </ComboBox>
                                                <TextBlock Margin="0,6,0,0" Text="数量上限" Style="{StaticResource CaptionStyle}" />
                                                <TextBox x:Name="BacktestMaxSymbolsTextBox" Margin="0,6,0,0" Height="30" Text="30" ToolTip="历史库模式下使用，建议先用 20-50 验证。" />
                                                <WrapPanel Margin="0,6,0,0">
                                                    <Button x:Name="BacktestScale20Button" Width="48" Height="26" Padding="6,0" Content="20" Click="BacktestScale20Button_Click" />
                                                    <Button x:Name="BacktestScale50Button" Width="48" Height="26" Padding="6,0" Content="50" Click="BacktestScale50Button_Click" />
                                                    <Button x:Name="BacktestScale100Button" Width="48" Height="26" Padding="6,0" Content="100" Click="BacktestScale100Button_Click" />
                                                </WrapPanel>
                                                <TextBlock Margin="0,10,0,0" Text="开始日期" Style="{StaticResource CaptionStyle}" />
                                                <controls:RadarDatePicker x:Name="BacktestStartDatePicker" Margin="0,6,0,0" Height="32" />
                                                <TextBlock Margin="0,6,0,0" Text="结束日期" Style="{StaticResource CaptionStyle}" />
                                                <controls:RadarDatePicker x:Name="BacktestEndDatePicker" Margin="0,6,0,0" Height="32" />
                                                <TextBlock Margin="0,6,0,0" Text="股票代码" Style="{StaticResource CaptionStyle}" />
                                                <TextBox x:Name="BacktestSymbolsTextBox" Margin="0,6,0,0" Height="30" Text="600000,300059" ToolTip="多个股票用逗号分隔，例如 300059,600000" />
                                                <TextBlock Margin="0,6,0,0" Text="策略代码" Style="{StaticResource CaptionStyle}" />
                                                <TextBox x:Name="BacktestStrategiesTextBox" Margin="0,6,0,0" Height="30" Text="moving-average-pullback-restart,platform-volume-breakout" ToolTip="留空表示使用全部启用策略" />
                                                <WrapPanel Margin="0,8,0,0">
                                                    <Button x:Name="RunBacktestButton" Width="76" Height="28" Padding="8,0" Content="执行" Style="{StaticResource PrimaryButtonStyle}" Click="RunBacktestButton_Click" />
                                                    <Button x:Name="UseSelectedSymbolBacktestButton" Width="84" Height="28" Padding="8,0" Content="当前股票" Click="UseSelectedSymbolBacktestButton_Click" />
                                                    <Button x:Name="ExportBacktestButton" Width="76" Height="28" Padding="8,0" Content="导出" Click="ExportBacktestButton_Click" />
                                                </WrapPanel>
                                                <CheckBox x:Name="BacktestPositive5DayCheckBox" Margin="0,8,0,0" Content="只看 5 日正收益策略" Click="BacktestPositive5DayCheckBox_Click" />
                                                <TextBlock x:Name="BacktestUsedSymbolsText" Margin="0,8,0,0" Foreground="{DynamicResource SubtleTextBrush}" Text="实际股票：--" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Margin="0,14,0,0" Text="策略汇总" FontWeight="SemiBold" />
                                        <ListBox x:Name="BacktestStrategySummaryListBox" Margin="0,8,0,0" MaxHeight="220">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="16">
                                                        <StackPanel>
                                                            <DockPanel>
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding SignalCountText}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding StrategyName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            </DockPanel>
                                                            <TextBlock Margin="0,6,0,0" Foreground="{Binding WinRateBrush}" FontSize="12" Text="{Binding WinRateText}" TextWrapping="Wrap" />
                                                            <TextBlock Margin="0,5,0,0" Foreground="{Binding ReturnBrush}" FontSize="12" Text="{Binding ReturnText}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <TextBlock Margin="0,14,0,0" Text="情绪分组表现" FontWeight="SemiBold" />
                                        <ListBox x:Name="BacktestSentimentSummaryListBox" Margin="0,8,0,0" MaxHeight="180">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource ReviewAccordionCardStyle}">
                                                        <StackPanel>
                                                            <DockPanel>
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding SignalCountText}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding SentimentLevel}" FontWeight="SemiBold" />
                                                            </DockPanel>
                                                            <TextBlock Margin="0,6,0,0" Foreground="{Binding WinRateBrush}" FontSize="12" Text="{Binding WinRateText}" TextWrapping="Wrap" />
                                                            <TextBlock Margin="0,5,0,0" Foreground="{Binding ReturnBrush}" FontSize="12" Text="{Binding ReturnText}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <TextBlock Margin="0,14,0,0" Text="回放命中" FontWeight="SemiBold" />
                                        <ListBox x:Name="BacktestResultListBox" Margin="0,8,0,0">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="16">
                                                        <StackPanel>
                                                            <DockPanel>
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding ScoreText}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" />
                                                                <TextBlock FontWeight="SemiBold">
                                                                    <Run Text="{Binding TradingDate}" />
                                                                    <Run Text="  " />
                                                                    <Run Text="{Binding Symbol}" />
                                                                    <Run Text=" " />
                                                                    <Run Text="{Binding Name}" />
                                                                </TextBlock>
                                                            </DockPanel>
                                                            <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource MutedTextBrush}" FontSize="12">
                                                                <Run Text="{Binding StrategyName}" />
                                                                <Run Text="   " />
                                                                <Run Text="{Binding ActionText}" />
                                                                <Run Text="   置信度 " />
                                                                <Run Text="{Binding ConfidenceText}" />
                                                            </TextBlock>
                                                            <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource PrimaryBrush}" FontSize="12" Text="{Binding ReturnText}" />
                                                            <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource SubtleTextBrush}" FontSize="12" Text="{Binding Reason}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </ScrollViewer>

                                <Grid x:Name="AuctionObservationPanel" Grid.Row="1" Margin="0,10,0,0" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Style="{StaticResource ReviewFilterBarStyle}">
                                        <DockPanel>
                                            <Button x:Name="AuctionObservationRefreshButton" DockPanel.Dock="Right" Content="刷新竞价" Style="{StaticResource PrimaryButtonStyle}" Click="AuctionObservationRefreshButton_Click" />
                                            <StackPanel>
                                                <TextBlock Text="集合竞价辅助观察" FontSize="18" FontWeight="SemiBold" />
                                                <TextBlock x:Name="AuctionObservationSummaryText" Margin="0,6,0,0" Text="上一交易日策略命中分数前50，独立观察，不参与策略评分。" Foreground="{DynamicResource MutedTextBrush}" />
                                                <TextBlock x:Name="AuctionObservationStatusText" Margin="0,4,0,0" Text="等待数据" Foreground="{DynamicResource SubtleTextBrush}" FontSize="12" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <Border Grid.Row="1" Margin="0,10,0,0" Style="{StaticResource ReviewCardStyle}">
                                        <TextBlock Text="集合竞价仅用于开盘前辅助观察；L2 未开通时不计算真实撤单率，盘口衰减只作为风险提示。" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" />
                                    </Border>
                                    <DataGrid x:Name="AuctionObservationDataGrid" Grid.Row="2" Margin="0,10,0,0" Style="{StaticResource ReviewDataGridStyle}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="股票" Binding="{Binding StockText}" Width="1.2*" />
                                            <DataGridTextColumn Header="昨日排名" Binding="{Binding SourceRankText}" Width="0.7*" />
                                            <DataGridTextColumn Header="昨日分数" Binding="{Binding SourceScoreText}" Width="0.8*" />
                                            <DataGridTextColumn Header="昨日策略" Binding="{Binding SourceStrategies}" Width="1.8*" />
                                            <DataGridTextColumn Header="竞价状态" Binding="{Binding Status}" Width="1.1*" />
                                            <DataGridTemplateColumn Header="竞价涨跌" Width="0.9*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding GapText}" Foreground="{Binding GapBrush}" FontWeight="SemiBold" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="盘口失衡" Binding="{Binding ImbalanceText}" Width="0.9*" />
                                            <DataGridTextColumn Header="风险" Binding="{Binding RiskText}" Width="0.9*" />
                                            <DataGridTextColumn Header="开盘确认" Binding="{Binding OpenConfirmStatus}" Width="1.1*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>

                                <Grid x:Name="LongTermTrackingPanel" Grid.Row="1" Margin="0,10,0,0" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,16">
                                        <Border Style="{StaticResource ReviewCardStyle}" Margin="0,0,12,0">
                                            <StackPanel>
                                                <TextBlock Text="跟踪标的" Foreground="{DynamicResource MutedTextBrush}" FontWeight="SemiBold" />
                                                <TextBlock x:Name="LongTermTrackingTotalMetricText" Margin="0,8,0,0" Text="0" Foreground="{DynamicResource PrimaryBrush}" FontSize="28" FontWeight="SemiBold" />
                                                <TextBlock Text="标的 / 策略组合" Foreground="{DynamicResource MutedTextBrush}" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource ReviewCardStyle}" Margin="0,0,12,0">
                                            <StackPanel>
                                                <TextBlock Text="策略组合" Foreground="{DynamicResource MutedTextBrush}" FontWeight="SemiBold" />
                                                <TextBlock x:Name="LongTermTrackingStrategyMetricText" Margin="0,8,0,0" Text="0" Foreground="{DynamicResource AccentBlueBrush}" FontSize="28" FontWeight="SemiBold" />
                                                <TextBlock Text="去重策略数" Foreground="{DynamicResource MutedTextBrush}" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource ReviewCardStyle}" Margin="0,0,12,0">
                                            <StackPanel>
                                                <TextBlock Text="今日命中" Foreground="{DynamicResource MutedTextBrush}" FontWeight="SemiBold" />
                                                <TextBlock x:Name="LongTermTrackingTodayMetricText" Margin="0,8,0,0" Text="0" Foreground="{DynamicResource SuccessBrush}" FontSize="28" FontWeight="SemiBold" />
                                                <TextBlock Text="最近命中在今天" Foreground="{DynamicResource MutedTextBrush}" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource ReviewCardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="待处理" Foreground="{DynamicResource MutedTextBrush}" FontWeight="SemiBold" />
                                                <TextBlock x:Name="LongTermTrackingPendingMetricText" Margin="0,8,0,0" Text="0" Foreground="{DynamicResource DangerBrush}" FontSize="28" FontWeight="SemiBold" />
                                                <TextBlock Text="存在风险提示" Foreground="{DynamicResource MutedTextBrush}" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <Border Grid.Row="1" Style="{StaticResource ReviewFilterBarStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="138" />
                                                <ColumnDefinition Width="138" />
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="118" />
                                                <ColumnDefinition Width="138" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="长期跟踪" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <Grid Grid.Column="1" Height="30" Margin="22,0,0,0">
                                                <TextBox x:Name="LongTermTrackingSymbolTextBox"
                                                         Height="30"
                                                         Padding="10,4"
                                                         Background="{DynamicResource CardDarkBrush}"
                                                         BorderBrush="{DynamicResource BorderBrushSoft}"
                                                         Foreground="{DynamicResource TextBrush}"
                                                         ToolTip="按股票代码或名称查询，例如 300059 或 东方财富" />
                                                <TextBlock Margin="11,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           IsHitTestVisible="False"
                                                           Text="股票代码 / 名称">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Text, ElementName=LongTermTrackingSymbolTextBox}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                            <controls:RadarDatePicker x:Name="LongTermTrackingFromDatePicker"
                                                        Grid.Column="2"
                                                        Width="124"
                                                        Height="30"
                                                        Margin="14,0,0,0"
                                                        Placeholder="开始日期"
                                                        ToolTip="首次命中日期范围的开始日期" />
                                            <controls:RadarDatePicker x:Name="LongTermTrackingToDatePicker"
                                                        Grid.Column="3"
                                                        Width="124"
                                                        Height="30"
                                                        Margin="14,0,0,0"
                                                        Placeholder="结束日期"
                                                        ToolTip="首次命中日期范围的结束日期" />
                                            <Grid Grid.Column="4" Height="30" Margin="14,0,0,0">
                                                <TextBox x:Name="LongTermTrackingStrategyCodeTextBox"
                                                         Height="30"
                                                         Padding="10,4"
                                                         Background="{DynamicResource CardDarkBrush}"
                                                         BorderBrush="{DynamicResource BorderBrushSoft}"
                                                         Foreground="{DynamicResource TextBrush}"
                                                         ToolTip="按策略编码过滤，例如 strong-trend-continuation" />
                                                <TextBlock Margin="11,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           IsHitTestVisible="False"
                                                           Text="策略代码">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Text, ElementName=LongTermTrackingStrategyCodeTextBox}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                            <ComboBox x:Name="LongTermTrackingStatusComboBox" Grid.Column="5" Width="104" Height="30" Margin="14,0,0,0" SelectedIndex="0" Style="{StaticResource RadarComboBoxStyle}">
                                                <ComboBoxItem Content="全部" Tag="" />
                                                <ComboBoxItem Content="观察" Tag="Watch" />
                                                <ComboBoxItem Content="重点" Tag="Focus" />
                                                <ComboBoxItem Content="放弃" Tag="GiveUp" />
                                                <ComboBoxItem Content="归档" Tag="Archived" />
                                            </ComboBox>
                                            <ComboBox x:Name="LongTermTrackingSortComboBox" Grid.Column="6" Width="124" Height="30" Margin="14,0,0,0" SelectedIndex="0" Style="{StaticResource RadarComboBoxStyle}">
                                                <ComboBoxItem Content="最近命中" Tag="LastHitAt" />
                                                <ComboBoxItem Content="首次命中" Tag="FirstHitAt" />
                                                <ComboBoxItem Content="命中次数" Tag="HitCount" />
                                                <ComboBoxItem Content="最新分" Tag="LatestScore" />
                                                <ComboBoxItem Content="最高分" Tag="BestScore" />
                                            </ComboBox>
                                            <Border Grid.Column="7" Margin="16,0,12,0" Padding="14,5" Background="{DynamicResource SoftPanelBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="15" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock x:Name="LongTermTrackingSummaryText" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" FontWeight="SemiBold" Text="沉淀非主线策略历史命中股票。" TextWrapping="NoWrap" />
                                            </Border>
                                            <Button x:Name="RefreshLongTermTrackingButton"
                                                    Grid.Column="8"
                                                    Width="76"
                                                    Height="30"
                                                    Margin="0"
                                                    Padding="8,0"
                                                    Content="查询"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Click="RefreshLongTermTrackingButton_Click" />
                                            <Button x:Name="BackfillLongTermTrackingButton"
                                                    Grid.Column="9"
                                                    Width="86"
                                                    Height="30"
                                                    Margin="8,0,0,0"
                                                    Padding="8,0"
                                                    Content="历史回填"
                                                    Click="BackfillLongTermTrackingButton_Click" />
                                        </Grid>
                                    </Border>

                                    <Border Grid.Row="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="0" Margin="0,16,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <DataGrid x:Name="LongTermTrackingDataGrid"
                                                      Grid.Row="0"
                                                      Style="{StaticResource ReviewDataGridStyle}"
                                                      Margin="0"
                                                      AutoGenerateColumns="False"
                                                      IsReadOnly="True"
                                                      CanUserAddRows="False"
                                                      CanUserDeleteRows="False"
                                                      CanUserReorderColumns="True"
                                                      CanUserResizeColumns="True"
                                                      CanUserSortColumns="True"
                                                      HeadersVisibility="Column"
                                                      GridLinesVisibility="Horizontal"
                                                      HorizontalGridLinesBrush="{DynamicResource BorderBrushSoft}"
                                                      BorderThickness="0"
                                                      Background="{DynamicResource CardBrush}"
                                                      RowBackground="{DynamicResource CardBrush}"
                                                      AlternatingRowBackground="{DynamicResource TableAltRowBrush}"
                                                      AlternationCount="2"
                                                      RowHeight="48"
                                                      ColumnHeaderHeight="40"
                                                      SelectionMode="Single"
                                                      SelectionUnit="FullRow"
                                                      EnableRowVirtualization="True"
                                                      EnableColumnVirtualization="True"
                                                      VirtualizingPanel.IsVirtualizing="True"
                                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                                      ScrollViewer.CanContentScroll="True"
                                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                <DataGrid.Resources>
                                                    <Style TargetType="DataGridColumnHeader">
                                                        <Setter Property="Background" Value="{DynamicResource SoftPanelBrush}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}" />
                                                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                                                        <Setter Property="Padding" Value="10,0" />
                                                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                                                    </Style>
                                                    <Style TargetType="DataGridCell">
                                                        <Setter Property="BorderThickness" Value="0" />
                                                        <Setter Property="Padding" Value="10,0" />
                                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                        <Style.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource TableSelectedBrush}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                    <Style TargetType="DataGridRow">
                                                        <Setter Property="BorderThickness" Value="0" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                        <Setter Property="Cursor" Value="Hand" />
                                                        <Style.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource TableSelectedBrush}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource TableHoverBrush}" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGrid.Resources>
                                                <DataGrid.Columns>
                                                    <DataGridTemplateColumn Header="股票" Width="2*" MinWidth="150" SortMemberPath="Symbol">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Margin="0,2,0,0" Text="{Binding Symbol}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" FontWeight="SemiBold" />
                                                                    </StackPanel>
                                                                    <Button Grid.Column="1"
                                                                            Style="{StaticResource CopySymbolButtonStyle}"
                                                                            Tag="{Binding Symbol}"
                                                                            Click="CopyOpportunitySymbolButton_Click">
                                                                        <Grid Width="14" Height="14">
                                                                            <Border Width="8" Height="8" Margin="0,0,1,1" HorizontalAlignment="Right" VerticalAlignment="Bottom" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" BorderThickness="1.2" CornerRadius="1" />
                                                                            <Border Width="8" Height="8" Margin="1,1,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource CardBrush}" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" BorderThickness="1.2" CornerRadius="1" />
                                                                        </Grid>
                                                                    </Button>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="策略" Width="2*" MinWidth="160" SortMemberPath="StrategyName">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Border Padding="10,3" Background="{DynamicResource PrimarySoftBrush}" CornerRadius="10" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding StrategyName}" Foreground="{DynamicResource AccentBlueBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTextColumn Header="命中次数" Binding="{Binding HitCountText}" SortMemberPath="HitCountText" Width="*" MinWidth="86" />
                                                    <DataGridTemplateColumn Header="当前价格" Width="*" MinWidth="110" SortMemberPath="CurrentPriceText">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding CurrentPriceText}" FontSize="14" FontWeight="SemiBold" />
                                                                    <TextBlock Margin="0,2,0,0" Text="{Binding ReturnFromHitText}" Foreground="{Binding ReturnFromHitBrush}" FontSize="12" FontWeight="SemiBold" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="状态" Width="2*" MinWidth="180">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <ItemsControl ItemsSource="{Binding StatusTags}" VerticalAlignment="Center">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Margin="0,0,6,4" Padding="8,3" Background="{Binding Background}" CornerRadius="10">
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <Ellipse Width="5" Height="5" Fill="{Binding Foreground}" VerticalAlignment="Center" />
                                                                                    <TextBlock Margin="5,0,0,0" Text="{Binding Text}" Foreground="{Binding Foreground}" FontSize="12" FontWeight="SemiBold" />
                                                                                </StackPanel>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTextColumn Header="首次 / 最新" Binding="{Binding HitRangeText}" Width="2*" MinWidth="170" />
                                                    <DataGridTextColumn Header="评分" Binding="{Binding ScoreText}" SortMemberPath="ScoreText" Width="*" MinWidth="90" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <Border Grid.Row="1" Margin="0,16,0,0" Padding="22,18" Background="{DynamicResource CardDarkBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1,1,0,0" CornerRadius="0,0,12,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*" />
                                                        <ColumnDefinition Width="40" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding SelectedItem.Name, ElementName=LongTermTrackingDataGrid, TargetNullValue=未选择}" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Margin="10,3,0,0" FontSize="13" Foreground="{DynamicResource MutedTextBrush}" FontWeight="SemiBold" Text="{Binding SelectedItem.Symbol, ElementName=LongTermTrackingDataGrid, TargetNullValue=--}" VerticalAlignment="Center" />
                                                            <Border Grid.Column="2" Margin="14,0,0,0" Padding="10,3" Background="{DynamicResource PrimarySoftBrush}" CornerRadius="10" VerticalAlignment="Center">

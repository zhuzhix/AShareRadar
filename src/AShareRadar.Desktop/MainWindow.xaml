                <Border x:Name="MarketSentimentAlertCard" Grid.Column="6" Padding="16,14" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0" CornerRadius="8">

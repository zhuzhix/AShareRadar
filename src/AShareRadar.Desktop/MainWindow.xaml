                                        <Button x:Name="LongTermTrackingViewButton" Width="108" Height="42" Margin="0" Padding="0" Content="长期跟踪" Visibility="Collapsed" Click="LongTermTrackingViewButton_Click" />
                                        <Button x:Name="BacktestViewButton" Width="108" Height="42" Margin="0" Padding="0" Content="策略回放" Visibility="Collapsed" Click="BacktestViewButton_Click" />
                                    </WrapPanel>
                                    </Border>
                                </StackPanel>
                                <ListBox x:Name="SignalEventListBox" Grid.Row="1" Margin="0,10,0,0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="16">

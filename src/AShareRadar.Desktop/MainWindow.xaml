                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource ReviewCardStyle}" Margin="0,0,12,0">
                                            <StackPanel>
                                                <TextBlock Text="策略数" Foreground="{DynamicResource MutedTextBrush}" FontWeight="SemiBold" />
                                                <TextBlock x:Name="DailyHitStrategyMetricText" Margin="0,8,0,0" Text="0" Foreground="{DynamicResource AccentBlueBrush}" FontSize="28" FontWeight="SemiBold" />
                                                <TextBlock Text="活跃策略" Foreground="{DynamicResource MutedTextBrush}" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource ReviewCardStyle}" Margin="0,0,12,0">
                                            <StackPanel>
                                                <TextBlock Text="命中率" Foreground="{DynamicResource MutedTextBrush}" FontWeight="SemiBold" />
                                                <TextBlock x:Name="DailyHitRateMetricText" Margin="0,8,0,0" Text="--" Foreground="{DynamicResource SuccessBrush}" FontSize="28" FontWeight="SemiBold" />

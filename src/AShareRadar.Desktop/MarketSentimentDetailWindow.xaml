<Window x:Class="AShareRadar.Desktop.MarketSentimentDetailWindow"
        Icon="Assets/app-icon.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="A股情绪详情"
        Height="760"
        Width="1080"
        MinHeight="640"
        MinWidth="980"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI"
        Background="#F3F5F7">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SoftPanelBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#DEE3EA" />
        <SolidColorBrush x:Key="TextBrush" Color="#172033" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#5E6978" />
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#8792A2" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#1769E0" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="#F0F2F5" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.82" />
                                <Setter TargetName="Chrome" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="PanelTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="CaptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="FlatListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="A股情绪详情" FontSize="22" FontWeight="SemiBold" />
                <TextBlock x:Name="HeaderStatusText" Margin="0,3,0,0" Text="正在读取情绪快照..." Style="{StaticResource CaptionStyle}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="刷新" Style="{StaticResource PrimaryButtonStyle}" Click="RefreshButton_Click" />
                <Button Content="关闭" Click="CloseButton_Click" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.RowSpan="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="当前温度" Style="{StaticResource PanelTitleStyle}" />
                        <StackPanel Margin="0,12,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="ScoreText" Text="--" FontSize="46" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                            <TextBlock Margin="6,24,0,0" Text="/100" Foreground="{StaticResource SubtleTextBrush}" />
                            <Border x:Name="LevelBadge" Margin="14,25,0,0" Height="24" Padding="10,0" Background="#EAF2FF" CornerRadius="5">
                                <TextBlock x:Name="LevelText" Text="等待" VerticalAlignment="Center" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>

                        <Grid Margin="0,8,0,0">
                            <Border Height="10" Background="#EEF2F7" CornerRadius="5" />
                            <Border x:Name="TemperatureFill" Height="10" Width="0" HorizontalAlignment="Left" Background="{StaticResource PrimaryBrush}" CornerRadius="5" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <TextBlock Text="冰点" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" HorizontalAlignment="Left" />
                            <TextBlock Text="偏热" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" HorizontalAlignment="Center" />
                            <TextBlock Text="爆表" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" HorizontalAlignment="Right" />
                        </Grid>

                        <Border x:Name="LevelGuideCard" Margin="0,10,0,0" Padding="10" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="7">
                            <StackPanel>
                                <TextBlock x:Name="LevelGuideTitleText" Text="等级提示：等待数据" FontWeight="SemiBold" />
                                <TextBlock x:Name="LevelGuideText" Margin="0,4,0,0" Text="情绪刷新后显示策略环境和风险提示。" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock x:Name="StrategyEnvironmentText" Margin="0,8,0,0" Text="策略环境：--" TextWrapping="Wrap" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="SummaryText" Margin="0,8,0,0" Text="等待数据" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />

                        <UniformGrid Margin="0,18,0,0" Columns="2">
                            <StackPanel Margin="0,0,10,10">
                                <TextBlock Text="数据质量" Style="{StaticResource CaptionStyle}" />
                                <TextBlock x:Name="DataQualityText" Margin="0,4,0,0" Text="--" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="更新时间" Style="{StaticResource CaptionStyle}" />
                                <TextBlock x:Name="SnapshotTimeText" Margin="0,4,0,0" Text="--" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="任务状态" Style="{StaticResource CaptionStyle}" />
                                <TextBlock x:Name="WorkerStatusText" Margin="0,4,0,0" Text="--" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="下次自动刷新" Style="{StaticResource CaptionStyle}" />
                                <TextBlock x:Name="NextRunText" Margin="0,4,0,0" Text="--" FontWeight="SemiBold" />
                            </StackPanel>
                        </UniformGrid>

                        <Border Margin="0,18,0,0" Padding="12" Background="#F8FBFD" BorderBrush="#CFE0F2" BorderThickness="1" CornerRadius="7">
                            <StackPanel>
                                <TextBlock Text="数据源状态" FontWeight="SemiBold" />
                                <ItemsControl x:Name="DataSourceStatusItemsControl" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,0,0,6">
                                                <TextBlock Text="{Binding Code}" Foreground="{StaticResource MutedTextBrush}" />
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,18,0,0" Padding="12" Background="#FFF8E8" BorderBrush="#FFE3A3" BorderThickness="1" CornerRadius="7">
                            <StackPanel>
                                <TextBlock Text="提示" FontWeight="SemiBold" />
                                <ItemsControl x:Name="WarningsItemsControl" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="0,0,0,6" Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="0,18,0,0" Text="六项分解" Style="{StaticResource PanelTitleStyle}" />
                        <ItemsControl x:Name="CategoriesItemsControl" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Padding="10" Background="{Binding Background}" BorderBrush="{Binding AccentBrush}" BorderThickness="1" CornerRadius="6">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" FontWeight="SemiBold" />
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                    <Border Height="20" Padding="8,0" Background="{Binding BadgeBrush}" CornerRadius="10">
                                                        <TextBlock Text="{Binding LevelText}" VerticalAlignment="Center" Foreground="{Binding AccentBrush}" FontSize="11" FontWeight="SemiBold" />
                                                    </Border>
                                                    <TextBlock Margin="8,1,0,0" Text="{Binding ScoreText}" HorizontalAlignment="Right" Foreground="{Binding AccentBrush}" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </DockPanel>
                                            <Border Margin="0,7,0,5" Height="6" Background="#E8EEF5" CornerRadius="3">
                                                <Border Width="{Binding BarWidth}" HorizontalAlignment="Left" Background="{Binding AccentBrush}" CornerRadius="3" />
                                            </Border>
                                            <TextBlock Margin="0,4,0,0" Text="{Binding Status}" Style="{StaticResource CaptionStyle}" />
                                            <TextBlock Margin="0,5,0,0" Text="{Binding Description}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="14,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="盘中情绪曲线" Style="{StaticResource PanelTitleStyle}" />
                        <TextBlock x:Name="ChartCaptionText" Margin="0,4,0,0" Text="当日最近 240 次快照" Style="{StaticResource CaptionStyle}" />
                    </StackPanel>
                    <Border Grid.Row="1" Margin="0,12,0,0" Background="#FAFAFC" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="6">
                        <Canvas x:Name="SentimentChartCanvas" MinHeight="300" SizeChanged="SentimentChartCanvas_SizeChanged" />
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="1" Grid.Column="1" Margin="14,14,0,0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="核心指标" Style="{StaticResource PanelTitleStyle}" />
                        <ItemsControl x:Name="MetricsGroupsItemsControl"
                                      Grid.Row="1"
                                      Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10" Padding="10" Background="{StaticResource SoftPanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="6">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" />
                                            </DockPanel>
                                            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Metrics}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,7">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="130" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                                                <TextBlock Margin="0,2,0,0" Text="{Binding SourceStatusText}" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="{Binding DisplayValue}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <Grid Grid.Column="1" Margin="16,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="最近 5 次快照" Style="{StaticResource PanelTitleStyle}" />
                        <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ListBox x:Name="RecentSnapshotsListBox"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     ItemContainerStyle="{StaticResource FlatListBoxItemStyle}"
                                     SelectionChanged="RecentSnapshotsListBox_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" Padding="10" Background="{StaticResource SoftPanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="6">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding TimeText}" FontWeight="SemiBold" />
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding ScoreText}" Foreground="{Binding AccentBrush}" FontWeight="SemiBold" />
                                                </DockPanel>
                                                <TextBlock Margin="0,4,0,0" Text="{Binding Level}" Foreground="{Binding AccentBrush}" FontWeight="SemiBold" FontSize="12" />
                                                <TextBlock Margin="0,4,0,0" Text="{Binding Summary}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
